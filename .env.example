# Amul WD Portal credentials
AMUL_WD_CODE=YOUR_WD_CODE

# Gmail IMAP credentials (used only to read the incoming OTP)
# Use a 16-character Google App Password, not your regular Gmail password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Telegram Bot credentials
# 1. Message @BotFather on Telegram to create a bot and get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot on Telegram to get your numeric TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Browser settings: true to run headless, false to show the browser window for local debugging
HEADLESS_MODE=true

# Date filter: smart, today, or yesterday
# In smart mode, uses yesterday between 00:00 and 06:00 IST and today otherwise
DATE_FILTER=smart
